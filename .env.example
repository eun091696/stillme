# Public application URL
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Public Supabase connection values. Obtain local values with `npm run supabase:start`.
# For the hosted development project, run `npm run supabase:env:development`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Development-only: grant test credits automatically. Never enable in production.
GENERATION_TEST_MODE=false

# Never expose the Supabase secret/service-role key to the browser.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Server-only Google AI credential. Never prefix this value with NEXT_PUBLIC_.
GOOGLE_AI_API_KEY=
GOOGLE_IMAGE_DEFAULT_MODEL=gemini-3.1-flash-image
GOOGLE_IMAGE_PRO_MODEL=gemini-3-pro-image
# Server-only vision model used to compare the source and generated face.
GOOGLE_IMAGE_VALIDATION_MODEL=gemini-3.1-flash-lite

# Server-only AWS Rekognition credentials for source/result face comparison.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
# Optional for temporary AWS credentials.
AWS_SESSION_TOKEN=

# Test-only credit bypass. The server ignores this in production.
IMAGE_CREDIT_BYPASS=true

# Server-only Cloudflare R2 S3 credentials for one private environment bucket.
R2_ACCOUNT_ID=replace-with-32-character-cloudflare-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=ai-photo-studio-development

# Optional bearer secret for manual generation Credit reconciliation.
GENERATION_RECONCILIATION_SECRET=replace-with-at-least-32-random-characters
# Vercel sends this server-only value as a Bearer token to scheduled Cron routes.
# Use at least 16 random characters in production; 32 or more is recommended.
CRON_SECRET=replace-with-at-least-32-random-characters

# Optional public support email. Leave blank until a real monitored address exists.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Server-only Toss Payments secret. Use a test key outside production.
TOSS_SECRET_KEY=replace-with-server-only-toss-secret-key

# Groble webhook and one-time payment products (server-only)
GROBLE_WEBHOOK_SECRET=replace-with-current-groble-webhook-secret
# Set only during Groble's 24-hour secret rotation window.
GROBLE_WEBHOOK_SECRET_PREVIOUS=
GROBLE_STARTER_CONTENT_ID=iwwH85
GROBLE_STARTER_OPTION_ID=
GROBLE_STARTER_PAYMENT_URL=https://www.groble.im/payment/iwwH85
GROBLE_STANDARD_CONTENT_ID=u9RTdR
GROBLE_STANDARD_OPTION_ID=
GROBLE_STANDARD_PAYMENT_URL=https://www.groble.im/payment/u9RTdR
GROBLE_PRO_CONTENT_ID=gr4xTv
GROBLE_PRO_OPTION_ID=
GROBLE_PRO_PAYMENT_URL=https://www.groble.im/payment/gr4xTv
