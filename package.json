{
  "name": "ai-photo-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "build": "next build",
    "benchmark:id-photo": "tsc -p scripts/benchmarks/tsconfig.json && node .benchmark-build/scripts/benchmarks/id-photo-consistency.js",
    "performance:check": "node scripts/check-performance-budget.mjs",
    "security:bundle-check": "node scripts/check-client-bundle-security.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src && node --test scripts/lib/*.test.mjs",
    "test:integration": "node scripts/test-local-integration.mjs",
    "test:e2e": "node scripts/test-local-e2e.mjs",
    "test:all": "npm run validate && npm run test:db && npm run test:integration && npm run test:e2e && npm run incident:drill:payment",
    "incident:drill:payment": "node scripts/run-local-payment-incident-drill.mjs",
    "test:watch": "vitest",
    "auth:support:case": "node scripts/create-auth-support-case.mjs",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local",
    "supabase:env:development": "node scripts/configure-supabase-development.mjs",
    "test:db": "node scripts/test-local-db.mjs",
    "docs:bootstrap": "node scripts/bootstrap-company.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "validate": "npm run docs:check && npm run typecheck && npm run lint && npm run test && npm run build && npm run performance:check && npm run security:bundle-check"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1137.0",
    "@aws-sdk/client-s3": "^3.1096.0",
    "@aws-sdk/s3-request-presigner": "^3.1096.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.8",
    "ai": "^7.0.112",
    "next": "15.5.27",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.6",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "supabase": "^2.109.1",
    "tailwindcss": "4.1.14",
    "typescript": "5.9.2",
    "vitest": "4.1.11",
    "fast-glob": "file:vendor/next-eslint-glob"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "minimatch@3": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10": {
      "brace-expansion": "5.0.12"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "source-map-js": "1.2.2",
    "vite": "6.4.4",
    "fast-glob": "$fast-glob"
  }
}
